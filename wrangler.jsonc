{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mywebsite",
  "compatibility_date": "2026-06-03",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/showreel/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
